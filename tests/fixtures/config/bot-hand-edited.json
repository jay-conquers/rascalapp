    "permitSec": 1,
    "platforms": "everywhere"
  },
  "quotes": ["plain string quote", { "quote": "uses the quote key", "by": "ace" }, { "id": 5, "message": "message key with id" }, { "id": 5, "text": "duplicate id is dropped" }, { "text": "   " }, 9],
  "thanks": { "follow": { "enabled": true }, "raid": { "enabled": "yes", "template": "  Raid {user}  " }, "unknown": { "enabled": true } },
  "shoutout": { "template": "   " },
  "hooks": [
    { "name": "Reader Hook", "command": "!Ask", "url": "https://hooks.example/in?token=keep", "timeout_ms": 100, "cooldown": "2", "userCooldown": 3, "roles": "mods", "reply": "chat", "enabled": true },
    { "name": "Reader Hook", "trigger": "ask2", "url": "https://hooks.example/second" },
