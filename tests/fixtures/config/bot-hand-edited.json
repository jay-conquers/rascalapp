  "portalPort": 80,
  "bindHost": "0.0.0.0",
  "publicUrl": "  https://bot.example.com/  ",
  "commands": [
    { "name": "!Hello", "response": "hi", "cooldownSec": "30", "userCooldownSec": -5, "level": "admin", "aliases": ["!HI", "hello", 7, "h-i"], "keywords": ["ALOT", "https://nope", "a", "two  words", "alot"], "count": "9", "platforms": "kick" },
    { "name": "hello", "response": "duplicate name is dropped" },
    { "name": "!!!", "response": "no usable name" },
    { "id": "Long-ID With Spaces", "name": "long", "response": "x", "cooldownSec": 999999 },
    "not an object",
    null
  ],
  "timers": [
    { "name": "Rotating", "messages": [{ "message": "first" }, { "text": "second", "enabled": false }, "  third  ", "", { "content": "fourth" }], "mode": "sometimes", "intervalSec": 5, "minChatLines": 9999, "messageIndex": 7 },
    { "name": "Empty", "messages": [], "message": "" },
    { "name": "Legacy", "message": "only one", "intervalSec": "120", "lastFiredAt": "yesterday" }
  ],
  "filters": {
    "blacklist": [{ "word": "a", "action": "ban" }, { "word": "  BadWord  ", "action": "explode", "timeoutSec": 0 }, { "word": 5 }],
    "whitelist": ["Clip", "clip", "x", 7],
    "links": { "enabled": "true", "action": "ban", "timeoutSec": 99999999 },
