# Copy to .env and fill in. chmod 600 .env. Never commit .env.

# DNS name that points at this machine. Caddy uses it for HTTPS.
PUBLIC_HOST=bot.example.com

# Browser origin. Must be https, except when you are testing on localhost.
PUBLIC_BASE_URL=https://bot.example.com

# Twitch application you create. No client is shipped with Rascal.
RASCAL_BOT_CLIENT_ID=
# Leave blank for a public PKCE client. Set it only if the Twitch app is confidential.
RASCAL_TWITCH_CLIENT_SECRET=

# The channel the bot joins. The numeric id is optional.
RASCAL_BOT_CHANNEL=
RASCAL_BOT_BROADCASTER_ID=

# Long random strings. The desktop app's admin token is the API key.
# The session secret signs portal cookies. A login also expires after 12 hours,
# on logout, and when the process restarts.
RASCAL_BOT_API_KEY=
RASCAL_BOT_SESSION_SECRET=

# Google OAuth client for YouTube chat. Web application type.
RASCAL_GOOGLE_CLIENT_ID=
RASCAL_GOOGLE_CLIENT_SECRET=

# Optional. Only the Kick relay reads this. `docker compose --profile kick up -d --build`.
# openssl rand -hex 32
# RELAY_SECRET=

# Optional. Set to 1 to allow an http hook to an RFC1918 address or a single-label
# name such as another container. Link-local, cloud metadata, and odd IP spellings stay blocked.
# RASCAL_HOOK_PRIVATE_HTTP=1
