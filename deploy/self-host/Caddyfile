# Replace nothing here. Set PUBLIC_HOST in .env to the DNS name that points at this machine.
# Caddy asks Let's Encrypt for a certificate for that name.

{$PUBLIC_HOST} {
	# Kick webhooks and the Rascal socket. The relay service starts with the kick profile.
	@relay path /webhooks/* /v1/*
	handle @relay {
		reverse_proxy relay:8790
	}
	handle {
		reverse_proxy bot:4788
	}
}
